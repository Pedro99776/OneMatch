# =============================================
# OneMatch — Variáveis de Ambiente
# =============================================
# Copie este arquivo para .env e preencha os valores.

# Django
DJANGO_SECRET_KEY=sua-chave-secreta-aqui
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# =============================================
# Banco de Dados (Local / Supabase)
# =============================================
# Para Supabase: copie os dados do painel do Supabase em
# Project Settings > Database > Connection parameters
# =============================================
DATABASE_NAME=onematch
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Exemplo Supabase (descomente e preencha):
# DATABASE_HOST=db.xxxxx.supabase.co
# DATABASE_PORT=5432
# DATABASE_USER=postgres
# DATABASE_PASSWORD=sua-senha-do-supabase
# DATABASE_NAME=postgres

# Redis (Necessário no futuro para o Chat)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Storage - Supabase S3
SUPABASE_S3_ENDPOINT_URL=https://[seu-projeto].supabase.co/storage/v1/s3
SUPABASE_STORAGE_BUCKET_NAME=onematch-profiles
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
